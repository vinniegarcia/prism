constexpr sampler s(coord::normalized, address::repeat, filter::linear);
constexpr sampler t(coord::pixel,
                    s_address::clamp_to_zero, t_address::clamp_to_edge, r_address::mirrored_repeat,
                    border_color::opaque_white,
                    mag_filter::nearest, min_filter::linear, mip_filter::none,
                    compare_func::less_equal,
                    reduction::minimum);

texture2d<float, access::read_write> rw;
texture2d<int, access::write, memory_coherence::memory_coherence_device> w;

threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
simdgroup_barrier(mem_flags::mem_none);
atomic_thread_fence(mem_flags::mem_texture, memory_order_seq_cst, thread_scope::thread_scope_device);

interpolant<float4, interpolation::no_perspective> uv;
vertex_value<float3>::get(vertex_index::first);
mesh<V, P, 64, 126, topology::triangle> m;
tex.gather(s, coord, int2(0), component::y);
imageblock_data_rate::sample;
cmd.draw_primitives(primitive_type::triangle, 0, 3, 1, 0);
cmd.set_cull_mode(cull_mode::back);
cmd.set_depth_clip_mode(depth_clip_mode::clamp);
cmd.set_triangle_fill_mode(triangle_fill_mode::lines);
cmd.set_front_facing_winding(winding::clockwise);
i.set_triangle_cull_mode(triangle_cull_mode::front);
i.set_geometry_cull_mode(geometry_cull_mode::bounding_box);
i.set_opacity_cull_mode(opacity_cull_mode::opaque);
i.force_opacity(forced_opacity::non_opaque);
geometry_type::curve; curve_basis::bezier; curve_type::round;

